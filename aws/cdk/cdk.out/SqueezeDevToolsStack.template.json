     "ImagePullCredentialsType": "CODEBUILD",
     "PrivilegedMode": false,
     "Type": "LINUX_CONTAINER"
    },
    "Name": "squeeze-ci-log-optimizer",
    "ServiceRole": {
     "Fn::GetAtt": [
      "SqueezeCiLogOptimizerProjectRole6B66D0C0",
      "Arn"
     ]
    },
    "Source": {
     "BuildSpec": "{\n  \"version\": \"0.2\",\n  \"phases\": {\n    \"install\": {\n      \"runtime-versions\": {\n        \"python\": \"3.12\"\n      },\n      \"commands\": [\n        \"echo \\\"Installing Squeeze Context Optimizer...\\\"\",\n        \"pip install boto3 --quiet\"\n      ]\n    },\n    \"build\": {\n      \"commands\": [\n        \"echo \\\"Simulating build & capturing verbose logs...\\\"\",\n        \"python3 -c \\\"for i in range(200): print(f'2026-09-19T14:40:00.{i:03d}Z [DEBUG] Compiling module chunk-{i%10} status=ok');\\\" > build_raw.log\",\n        \"echo \\\"2026-09-19T14:40:02.100Z [ERROR] Test Suite Failure: assertion failed: token.is_valid() expected true, found false\\\" >> build_raw.log\"\n      ]\n    },\n    \"post_build\": {\n      \"commands\": [\n        \"echo \\\"⚡ Squeezing build logs...\\\"\",\n        \"python3 -c \\\"import urllib.request, json; print('Log compressed 85%')\\\"\"\n      ]\n    }\n  },\n  \"artifacts\": {\n    \"files\": [\n      \"build_raw.log\"\n    ]\n  }\n}",
     "Type": "NO_SOURCE"
    },
    "Tags": [
     {
      "Key": "Hackathon",
      "Value": "Bedrock-Context-Optimizer"
     },
     {
      "Key": "ManagedBy",
      "Value": "AWS-CDK"
     },
     {
      "Key": "Project",
      "Value": "Squeeze-AI"
     }
    ]
   },
   "Metadata": {
